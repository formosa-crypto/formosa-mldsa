require "../parameters.jinc"

namespace gamma1 {
    inline
    fn __encode_polynomial(
        reg ptr u8[ENCODED_GAMMA1_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u8[ENCODED_GAMMA1_POLYNOMIAL_SIZE]
    {
        reg u64 i;
        reg u32 encoded_bytes;
        reg u32 byte;
        reg u32 t0 t1;
        reg u64 output_offset;

        output_offset = 0;

        i = 0;
        while (i < COEFFICIENTS_IN_POLYNOMIAL / 2) {
            // t0 = GAMMA1 - polynomial[2*i + 0];
            t0 = GAMMA1;
            reg u64 hoisted_sindex_0 = i << 1;
            hoisted_sindex_0 += 0;
            reg u32 memop_0 = polynomial[hoisted_sindex_0];
            t0 -= memop_0;

            // t1 = GAMMA1 - polynomial[2*i+1];
            t1 = GAMMA1;
            reg u64 hoisted_sindex_1 = i << 1;
            hoisted_sindex_1 += 1;
            reg u32 memop_1 = polynomial[hoisted_sindex_1];
            t1 -= memop_1;

            // encoded[5*i + 0] = t0;
            encoded_bytes = t0;
            encoded[output_offset] = (8u)encoded_bytes;

            // encoded[5*i + 1]  = t0 >> 8;
            encoded_bytes = t0;
            encoded_bytes >>= 8;
            reg u64 hoisted_index_0 = output_offset + 1;
            encoded[hoisted_index_0] = (8u)encoded_bytes;

            // encoded[5*i + 2]  = t0 >> 16;
            encoded_bytes = t0;
            encoded_bytes >>= 16;
            byte = encoded_bytes;
            byte &= 0xFF;

            // encoded[5*i + 2] |= t1 << 4;
            encoded_bytes = t1;
            encoded_bytes <<= 4;
            reg u32 andtmp_0 = encoded_bytes;
            andtmp_0 &= 0xFF;
            byte |= andtmp_0;
            reg u64 hoisted_index_1 = output_offset + 2;
            encoded[hoisted_index_1] = byte;

            // encoded[5*i + 3]  = t1 >> 4;
            encoded_bytes = t1;
            encoded_bytes >>= 4;
            reg u64 hoisted_index_2 = output_offset + 3;
            encoded[hoisted_index_2] = (8u)encoded_bytes;

            // encoded[5*i + 4]  = t1 >> 12;
            encoded_bytes = t1;
            encoded_bytes >>= 12;
            reg u64 hoisted_index_3 = output_offset + 4;
            encoded[hoisted_index_3] = (8u)encoded_bytes;

            output_offset += 5;
            i += 1;
        }

        return encoded;
    }

    inline
    fn __decode_to_polynomial(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
        reg ptr u8[ENCODED_GAMMA1_POLYNOMIAL_SIZE] bytes
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u32 coefficient temp;

        reg u64 input_offset = 0;
        reg u64 output_offset = 0;

        while(input_offset < ENCODED_GAMMA1_POLYNOMIAL_SIZE) {
            // polynomial[2*i+0]  = bytes[5*i+0];
            // polynomial[2*i+0] |= (uint32_t)bytes[5*i+1] << 8;
            // polynomial[2*i+0] |= (uint32_t)bytes[5*i+2] << 16;
            // polynomial[2*i+0] = GAMMA1 - polynomial[2*i+0];

            coefficient = (32u) bytes[input_offset];
            reg u64 hoisted_index_4 = input_offset + 1;
            temp = (32u) bytes[hoisted_index_4];
            temp <<= 8;
            coefficient |= temp;

            reg u64 hoisted_index_5 = input_offset + 2;
            temp = (32u) bytes[hoisted_index_5];
            temp <<= 16;
            coefficient |= temp;

            coefficient &= 0xFFFFF;
            coefficient = -coefficient;
            coefficient += GAMMA1;
            reg u64 hoisted_index_6 = output_offset + 0;
            polynomial[hoisted_index_6] = coefficient;

            // polynomial[2*i+1]  = bytes[5*i+2] >> 4;
            // polynomial[2*i+1] |= (uint32_t)bytes[5*i+3] << 4;
            // polynomial[2*i+1] |= (uint32_t)bytes[5*i+4] << 12;
            // polynomial[2*i+1] = GAMMA1 - polynomial[2*i+1];

            reg u64 hoisted_index_7 = input_offset + 2;
            coefficient = (32u) bytes[hoisted_index_7];
            coefficient >>= 4;

            reg u64 hoisted_index_8 = input_offset + 3;
            temp = (32u) bytes[hoisted_index_8];
            temp <<= 4;
            coefficient |= temp;

            reg u64 hoisted_index_9 = input_offset + 4;
            temp = (32u) bytes[hoisted_index_9];
            temp <<= 12;
            coefficient |= temp;

            coefficient = -coefficient;
            coefficient += GAMMA1;
            reg u64 hoisted_index_10 = output_offset + 1;
            polynomial[hoisted_index_10] = coefficient;

            // Update counters
            input_offset += 5;
            output_offset += 2;
        }

        return polynomial;
    }

    inline
    fn __decode(
        reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL] decoded,
        reg ptr u8[GAMMA1_ENCODED_SIZE] encoded
    ) -> reg ptr u32[COLUMNS_IN_MATRIX_A * COEFFICIENTS_IN_POLYNOMIAL]
    {
        inline int i;

        for i = 0 to COLUMNS_IN_MATRIX_A {

            decoded[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL] =
                __decode_to_polynomial(
                    decoded[i * COEFFICIENTS_IN_POLYNOMIAL : COEFFICIENTS_IN_POLYNOMIAL],
                    encoded[i * ENCODED_GAMMA1_POLYNOMIAL_SIZE : ENCODED_GAMMA1_POLYNOMIAL_SIZE]
                );
        }

        return decoded;
    }
}
