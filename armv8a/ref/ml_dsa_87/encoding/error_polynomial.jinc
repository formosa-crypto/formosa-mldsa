require "../parameters.jinc"

// N.B.: This file varies according to parameter set.

namespace error_polynomial {
    fn encode(
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded,
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial
    ) -> reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE]
    {
            reg u32 encoded_byte;

            reg u32 t0 t1 t2 t3 t4 t5 t6 t7;

            reg u64 i = 0;
            reg u64 out_offset = 0;

            while (i < COEFFICIENTS_IN_POLYNOMIAL) {
                // r[3*i+0]  = (t[0] >> 0) | (t[1] << 3) | (t[2] << 6);
                t0 = ETA;
                reg u64 hoisted_index_0 = i + 0;
                reg u32 memop_0 = polynomial[hoisted_index_0];
                t0 -= memop_0;

                t1 = ETA;
                reg u64 hoisted_index_1 = i + 1;
                reg u32 memop_1 = polynomial[hoisted_index_1];
                t1 -= memop_1;
                t1 <<= 3;

                t2 = ETA;
                reg u64 hoisted_index_2 = i + 2;
                reg u32 memop_2 = polynomial[hoisted_index_2];
                t2 -= memop_2;

                encoded_byte = t2 << 6;
                encoded_byte |= t0;
                encoded_byte |= t1;
                reg u64 hoisted_index_3 = out_offset + 0;
                encoded[hoisted_index_3] = (8u)encoded_byte;

                // r[3*i+1]  = (t[2] >> 2) | (t[3] << 1) | (t[4] << 4) | (t[5] << 7);
                encoded_byte >>= 8;

                t3 = ETA;
                reg u64 hoisted_index_4 = i + 3;
                reg u32 memop_3 = polynomial[hoisted_index_4];
                t3 -= memop_3;
                t3 <<= 1;

                t4 = ETA;
                reg u64 hoisted_index_5 = i + 4;
                reg u32 memop_4 = polynomial[hoisted_index_5];
                t4 -= memop_4;
                t4 <<= 4;

                t5 = ETA;
                reg u64 hoisted_index_6 = i + 5;
                reg u32 memop_5 = polynomial[hoisted_index_6];
                t5 -= memop_5;
                t5 <<= 7;

                encoded_byte |= t3;
                encoded_byte |= t4;
                encoded_byte |= t5;
                reg u64 hoisted_index_7 = out_offset + 1;
                encoded[hoisted_index_7] = (8u)encoded_byte;

                // r[3*i+2]  = (t[5] >> 1) | (t[6] << 2) | (t[7] << 5);
                encoded_byte >>= 8;

                t6 = ETA;
                reg u64 hoisted_index_8 = i + 6;
                reg u32 memop_6 = polynomial[hoisted_index_8];
                t6 -= memop_6;
                t6 <<= 2;

                t7 = ETA;
                reg u64 hoisted_index_9 = i + 7;
                reg u32 memop_7 = polynomial[hoisted_index_9];
                t7 -= memop_7;
                t7 <<= 5;

                encoded_byte |= t6;
                encoded_byte |= t7;
                reg u64 hoisted_index_10 = out_offset + 2;
                encoded[hoisted_index_10] = (8u)encoded_byte;

                i += 8;
                out_offset += 3;
            }

            return encoded;
    }

    fn decode(
        reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL] polynomial,
        reg ptr u8[ENCODED_ERROR_POLYNOMIAL_SIZE] encoded
    ) -> reg ptr u32[COEFFICIENTS_IN_POLYNOMIAL]
    {
        reg u32 t0 t1 t2;
        reg u32 coefficient temp;

        inline int ETA_BITS_MASK = (1 << 3) - 1;

        reg u64 input_offset = 0;
        reg u64 out_offset = 0;

        while (input_offset < ENCODED_ERROR_POLYNOMIAL_SIZE) {
            reg u64 hoisted_index_11 = input_offset + 0;
            t0 = (32u) encoded[hoisted_index_11];
            reg u64 hoisted_index_12 = input_offset + 1;
            t1 = (32u) encoded[hoisted_index_12];
            reg u64 hoisted_index_13 = input_offset + 2;
            t2 = (32u) encoded[hoisted_index_13];

            // r->coeffs[8*i+0] = (a[3*i+0] >> 0) & 7;
            // r->coeffs[8*i+0] = ETA - r->coeffs[8*i+0];
            temp = t0;
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            polynomial[out_offset] = coefficient;

            // r->coeffs[8*i+1] =  (a[3*i+0] >> 3) & 7;
            // r->coeffs[8*i+1] = ETA - r->coeffs[8*i+1];
            temp = t0;
            temp >>= 3;
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            reg u64 hoisted_index_14 = out_offset + 1;
            polynomial[hoisted_index_14] = coefficient;

            // r->coeffs[8*i+2] = ((a[3*i+0] >> 6) | (a[3*i+1] << 2)) & 7;
            // r->coeffs[8*i+2] = ETA - r->coeffs[8*i+2];
            temp = t0 >> 6;
            temp = temp + (t1 << 2);
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            reg u64 hoisted_index_15 = out_offset + 2;
            polynomial[hoisted_index_15] = coefficient;

            // r->coeffs[8*i+3] =  (a[3*i+1] >> 1) & 7;
            // r->coeffs[8*i+3] = ETA - r->coeffs[8*i+3];
            temp = t1;
            temp >>= 1;
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            reg u64 hoisted_index_16 = out_offset + 3;
            polynomial[hoisted_index_16] = coefficient;

            // r->coeffs[8*i+4] =  (a[3*i+1] >> 4) & 7;
            // r->coeffs[8*i+4] = ETA - r->coeffs[8*i+4];
            temp = t1;
            temp >>= 4;
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            reg u64 hoisted_index_17 = out_offset + 4;
            polynomial[hoisted_index_17] = coefficient;

            // r->coeffs[8*i+5] = ((a[3*i+1] >> 7) | (a[3*i+2] << 1)) & 7;
            // r->coeffs[8*i+5] = ETA - r->coeffs[8*i+5];
            temp = t1 >> 7;
            temp = temp + (t2 << 1);
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            reg u64 hoisted_index_18 = out_offset + 5;
            polynomial[hoisted_index_18] = coefficient;

            // r->coeffs[8*i+6] =  (a[3*i+2] >> 2) & 7;
            // r->coeffs[8*i+6] = ETA - r->coeffs[8*i+6];
            temp = t2;
            temp >>= 2;
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            reg u64 hoisted_index_19 = out_offset + 6;
            polynomial[hoisted_index_19] = coefficient;

            // r->coeffs[8*i+7] =  (a[3*i+2] >> 5) & 7;
            // r->coeffs[8*i+7] = ETA - r->coeffs[8*i+7];
            temp = t2 >> 5;
            temp &= ETA_BITS_MASK;

            coefficient = ETA;
            coefficient -= temp;

            reg u64 hoisted_index_20 = out_offset + 7;
            polynomial[hoisted_index_20] = coefficient;

            input_offset += 3;
            out_offset += 8;
        }

        return polynomial;
    }
}
