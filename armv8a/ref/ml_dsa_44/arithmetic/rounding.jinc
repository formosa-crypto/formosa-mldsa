from Common require "arithmetic/rounding.jinc"

namespace coefficient {
    inline
    fn __decompose(reg u32 r) -> reg u32, reg u32 {
        reg u32 temp high_bits low_bits;

        // Compute ceil((r + 127) >> 7);
        high_bits = r;
        high_bits += 127;
        high_bits >>s= 7;

        // Compute (( (ceil(r + 127) >> 7) * 11_275) + (1 << 23) ) >> 24;
        reg u32 mulconst_101 = 11_275;
        high_bits *= mulconst_101;
        high_bits += (1 << 23);
        high_bits >>s= 24;

        // Compute high_bits ^= ((43 - high_bits) >> 31) & high_bits;
        // to handle the corner case.
        temp = 43;
        temp -= high_bits;
        temp >>s= 31;
        temp &= high_bits;

        high_bits ^= temp;

        // Compute low_bits = r - (r1 * (GAMMA2 * 2));
        temp = high_bits;
        reg u32 mulconst_102 = GAMMA2 * 2;
        temp *= mulconst_102;

        low_bits = r;
        low_bits -= temp;

        // Compute low_bits -= (((MODULUS - 1) / 2 - low_bits) >> 31) & MODULUS
        // to account for the corner case.
        temp = (MODULUS - 1) / 2;
        temp -= low_bits;
        temp >>s= 31;
        reg u32 modulus_mask = MODULUS;
        temp &= modulus_mask;

        low_bits -= temp;

        return low_bits, high_bits;
    }

    inline
    fn __use_hint(reg u32 a hint) -> reg u32 {
        reg u32 high_bits low_bits;

        reg bool b;

        low_bits, high_bits = __decompose(a);

        b = hint != 0;
        if (b) {

            b = low_bits >s 0;
            if (b) {

                b = high_bits == 43;
                if (b) {

                    high_bits = 0;
                } else {

                    high_bits += 1;
                }
            } else {

                b = high_bits == 0;
                if (b) {

                    high_bits = 43;
                } else {

                    high_bits -= 1;
                }
            }
        } else {
        }

        return high_bits;
    }
}
